{
  "name": "awap-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "${DB_HOST}",
    "database.port": "${DB_PORT}",
    "database.user": "${DB_USER}",
    "database.password": "${DB_PASSWORD}",
    "database.dbname": "${DB_NAME}",
    "topic.prefix": "awap",
    "schema.include.list": "public",
    "table.include.list": "public.outbox_events",
    "plugin.name": "pgoutput",
    "slot.name": "awap_outbox",
    "publication.name": "awap_outbox_pub",
    "publication.autocreate.mode": "filtered",
    "snapshot.mode": "no_data",
    "tombstones.on.delete": "false",
    "heartbeat.interval.ms": "10000",
    "max.batch.size": "2048",
    "poll.interval.ms": "250",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "awap.cdc.dead-letter",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "transforms": "outbox,extractTenant",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.field.event.payload": "payload_json",
    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "outbox.event.${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "tenant_id:header:tenantId",
    "transforms.extractTenant.type": "org.apache.kafka.connect.transforms.InsertHeader",
    "transforms.extractTenant.header": "x-awap-source",
    "transforms.extractTenant.value.literal": "debezium-cdc"
  }
}
