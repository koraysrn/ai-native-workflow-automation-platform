# Copy to .env and override before `docker compose up`. Defaults below are for
# local development only and MUST be replaced in staging/production (Sealed
# Secrets / External Secrets in Kubernetes).
POSTGRES_DB=awap
POSTGRES_USER=awap
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=awapadmin
MINIO_ROOT_PASSWORD=change-me
GF_ADMIN_PASSWORD=change-me
VAULT_DEV_ROOT_TOKEN=change-me
# Outbound webhooks: sign every request and keep the allowlist fail-closed. The local stack only
# trusts the in-network fake webhook for private-range SSRF checks.
WEBHOOK_SECRET=change-me
WEBHOOK_ALLOWED_HOSTS=fake-webhook,localhost
WEBHOOK_SSRF_TRUSTED_HOSTS=fake-webhook
