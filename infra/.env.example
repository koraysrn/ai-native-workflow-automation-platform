# Copy to .env and override before `docker compose up`. Defaults below are for
# local development only and MUST be replaced in staging/production (Sealed
# Secrets / External Secrets in Kubernetes).
POSTGRES_DB=awap
POSTGRES_USER=awap
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=awapadmin
MINIO_ROOT_PASSWORD=change-me
GF_ADMIN_PASSWORD=change-me
VAULT_DEV_ROOT_TOKEN=change-me
