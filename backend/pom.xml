<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.awap</groupId>
    <artifactId>awap-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AWAP Backend</name>
    <description>AI-Native Workflow Automation Platform - Backend (Java 25 / Spring Boot 4.1.1)</description>

    <modules>
        <module>common</module>
        <module>identity</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-cloud.version>2025.1.2</spring-cloud.version>

        <!-- Security patch overrides for the Jackson BOMs managed by Spring Boot 4.1.1.
             CVE-2026-89407 / CVE-2026-89425 / CVE-2026-68497 / CVE-2026-91776 /
             CVE-2026-91777 are fixed in 2.21.7 (Jackson 2) and 3.1.7 (Jackson 3). -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>

        <mapstruct.version>1.6.3</mapstruct.version>
        <archunit.version>1.5.1</archunit.version>
        <springdoc.version>3.1.1</springdoc.version>
        <spotless.version>3.10.4</spotless.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <pitest.version>1.30.1</pitest.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <jacoco.version>0.8.15</jacoco.version>
        <jjwt.version>0.12.6</jjwt.version>
        <jacoco.skip>false</jacoco.skip>
        <!-- The shared kernel still produces a coverage report for Sonar new-code coverage, but
             its bundle gate is evaluated by the modules that own the business behaviour. -->
        <jacoco.skip.check>false</jacoco.skip.check>

        <!-- Security floors for transitive dependencies. CI scans the aggregate
             CycloneDX SBOM, so these versions are exactly what ships:
             guava 33.4.8-jre / snappy-java 1.1.10.7 / lz4-java 1.10.1 and
             tomcat-embed 11.0.24 all carry HIGH advisories that the fixed
             versions below resolve. -->
        <guava.version>33.7.2-jre</guava.version>
        <snappy-java.version>1.1.10.9</snappy-java.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <tomcat.version>11.0.25</tomcat.version>

        <!-- SonarQube analysis (issue #182). The SonarScanner for Maven reads
             analysis parameters from the <properties> section of the pom; it
             does not read sonar-project.properties. sonar.organization is
             mandatory on SonarQube Cloud and sonar.projectKey must match the
             project bound to this repository. sonar.sources/sonar.tests stay
             unset so Maven infers them per module. -->
        <sonar.projectKey>koraysrn_ai-native-workflow-automation-platform</sonar.projectKey>
        <sonar.organization>koraysrn</sonar.organization>
        <sonar.projectName>AI-Native Workflow Automation Platform</sonar.projectName>
        <sonar.java.source>25</sonar.java.source>
        <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
        <sonar.coverage.jacoco.xmlReportPaths>common/target/site/jacoco/jacoco.xml,identity/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.junit.reportPaths>common/target/surefire-reports,identity/target/surefire-reports</sonar.junit.reportPaths>
        <sonar.exclusions>**/target/**,**/generated-sources/**,**/generated-test-sources/**,**/*MapperImpl.java</sonar.exclusions>
        <sonar.coverage.exclusions>**/interfaces/dto/**,**/config/**,**/IdentityApplication.java</sonar.coverage.exclusions>
        <sonar.cpd.exclusions>**/interfaces/dto/**,**/generated-sources/**</sonar.cpd.exclusions>
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
        <sonar.qualitygate.timeout>600</sonar.qualitygate.timeout>

        <!-- Issue #196 coverage ratchet. Step 1 is active: the measured baseline is
             85.7% line / 71.9% branch, so the gate now enforces 80/60 instead of the
             old 55/35. Activate later steps with -Pcoverage-step2 / -Pcoverage-step3
             (see docs/coverage-ratchet.md for dates and ownership). -->
        <coverage.bundle.line.min>0.80</coverage.bundle.line.min>
        <coverage.bundle.branch.min>0.60</coverage.bundle.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.awap</groupId>
                <artifactId>awap-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat/>
                            <importOrder/>
                            <removeUnusedImports/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>checkstyle.xml</configLocation>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>true</failsOnError>
                        <linkXRef>false</linkXRef>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <configuration>
                        <targetClasses>
                            <param>com.awap.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>com.awap.*</param>
                        </targetTests>
                        <mutators>
                            <mutator>DEFAULTS</mutator>
                        </mutators>
                        <outputFormats>
                            <outputFormat>HTML</outputFormat>
                            <outputFormat>XML</outputFormat>
                        </outputFormats>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.skip.check}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Issue #196: ratcheted from 0.55 to the project
                                                 target 0.80. The measured baseline is 0.857. -->
                                            <minimum>${coverage.bundle.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Step 1 of the branch ratchet (measured 0.719).
                                                 Step 2 (0.75) and step 3 (0.90) are encoded as
                                                 Maven profiles. -->
                                            <minimum>${coverage.bundle.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                    <excludes>
                                        <exclude>com.awap.identity.IdentityApplication</exclude>
                                        <exclude>com.awap.**.config.*</exclude>
                                        <exclude>com.awap.**.interfaces.dto.*</exclude>
                                    </excludes>
                                </rule>
                                <!-- Issue #127: tenant template CRUD, validation, rendering and
                                     cache paths must stay above 95% line / 90% branch. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.awap.notification.domain.NotificationTemplate</include>
                                        <include>com.awap.notification.domain.NotificationTemplateVersion</include>
                                        <include>com.awap.notification.domain.NotificationTemplateValidator</include>
                                        <include>com.awap.notification.domain.NotificationTemplateLocale</include>
                                        <include>com.awap.notification.application.NotificationTemplateRenderer</include>
                                        <include>com.awap.notification.application.NotificationTemplateService</include>
                                        <include>com.awap.notification.interfaces.api.NotificationTemplateController</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Issue #134: the designer expression contract (sandbox,
                                     dry-run service, metrics and endpoint) must stay above the
                                     stated 95% line / 90% branch gate. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.awap.workflow.application.WorkflowExpressionValidationService</include>
                                        <include>com.awap.workflow.application.WorkflowExpressionValidationMetrics</include>
                                        <include>com.awap.workflow.interfaces.api.WorkflowDefinitionController</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Issue #194: position-based role assignment domain and service
                                     must stay above 95% line / 90% branch. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.awap.organization.domain.Position</include>
                                        <include>com.awap.organization.application.OrganizationService</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Issue #195: the organization module is a critical module and
                                     must stay above 95% line / 90% branch at package level. DTOs
                                     are excluded because they are generated mapping records. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.awap.organization.application</include>
                                        <include>com.awap.organization.domain</include>
                                        <include>com.awap.organization.interfaces.api</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Issue #196: additional critical-class gates. These classes
                                     already meet the 95% line / 90% branch target and must not
                                     regress. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.awap.ai.application.AiBudgetGuard</include>
                                        <include>com.awap.ai.application.AiNodeService</include>
                                        <include>com.awap.file.application.FileScanEventBus</include>
                                        <include>com.awap.webhook.infrastructure.WebhookVerifier</include>
                                        <include>com.awap.engine.application.NodeTimeoutHandler</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Issue #133: the saga orchestrator and its state machine must
                                     stay above the stated 95% line / 90% branch gate. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.awap.engine.application.SagaService</include>
                                        <include>com.awap.engine.application.SagaCompensationScheduler</include>
                                        <include>com.awap.engine.application.SagaMetrics</include>
                                        <include>com.awap.engine.application.SagaRecoveryCandidate</include>
                                        <include>com.awap.engine.application.SagaCompensationConfig</include>
                                        <include>com.awap.engine.domain.SagaInstance</include>
                                        <include>com.awap.engine.domain.SagaStep</include>
                                        <include>com.awap.engine.domain.SagaStatus</include>
                                        <include>com.awap.engine.domain.SagaStepStatus</include>
                                        <include>com.awap.engine.infrastructure.JdbcSagaRecoveryRepository</include>
                                        <include>com.awap.engine.interfaces.api.SagaController</include>
                                        <include>com.awap.engine.interfaces.dto.SagaMapper</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6,)</version>
                                </requireMavenVersion>
                                <!-- Issue #181: ADR-001 adopts package-level layers. The split
                                     layer Maven modules must never be introduced. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.awap:awap-domain</exclude>
                                        <exclude>com.awap:awap-application</exclude>
                                        <exclude>com.awap:awap-infrastructure</exclude>
                                        <exclude>com.awap:awap-interfaces</exclude>
                                    </excludes>
                                    <message>
                                        ADR-001 adopts package-level layers; the split Maven layer modules
                                        (awap-domain, awap-application, awap-infrastructure, awap-interfaces)
                                        must not be introduced.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>coverage-step2</id>
            <properties>
                <coverage.bundle.line.min>0.80</coverage.bundle.line.min>
                <coverage.bundle.branch.min>0.75</coverage.bundle.branch.min>
            </properties>
        </profile>
        <profile>
            <id>coverage-step3</id>
            <properties>
                <coverage.bundle.line.min>0.80</coverage.bundle.line.min>
                <coverage.bundle.branch.min>0.90</coverage.bundle.branch.min>
            </properties>
        </profile>
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Critical domain classes whose state machines and invariants
                                 must be mutation-tested. -->
                            <targetClasses>
                                <param>com.awap.task.domain.Task</param>
                                <param>com.awap.organization.domain.Position</param>
                                <param>com.awap.engine.domain.WorkflowInstance</param>
                                <param>com.awap.engine.domain.NodeExecution</param>
                                <param>com.awap.workflow.domain.WorkflowDefinition</param>
                                <param>com.awap.form.domain.FormDefinition</param>
                                <param>com.awap.identity.domain.Tenant</param>
                                <param>com.awap.identity.domain.User</param>
                                <param>com.awap.engine.domain.OutboxEvent</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.awap.task.domain.TaskTest</param>
                                <param>com.awap.organization.domain.*</param>
                                <param>com.awap.engine.domain.*</param>
                                <param>com.awap.workflow.domain.*</param>
                                <param>com.awap.form.domain.*</param>
                                <param>com.awap.identity.domain.*</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <mutationThreshold>80</mutationThreshold>
                            <coverageThreshold>80</coverageThreshold>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pit-organization</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Issue #195: hierarchy entities, soft-delete flags and the
                                 position-role invariants are the mutation-tested domain paths. -->
                            <targetClasses>
                                <param>com.awap.organization.domain.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.awap.organization.domain.*</param>
                                <param>com.awap.organization.application.OrganizationServiceTest</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <outputDirectory>${project.build.directory}/pit-reports-organization</outputDirectory>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <mutationThreshold>80</mutationThreshold>
                            <coverageThreshold>80</coverageThreshold>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pit-notification</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Issue #127: placeholder validation, fallback and cache
                                 invalidation are the critical mutation-tested paths. -->
                            <targetClasses>
                                <param>com.awap.notification.domain.NotificationTemplateValidator</param>
                                <param>com.awap.notification.domain.NotificationTemplateLocale</param>
                                <param>com.awap.notification.application.NotificationTemplateRenderer</param>
                                <param>com.awap.notification.application.NotificationTemplateService</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.awap.notification.domain.NotificationTemplate*</param>
                                <param>com.awap.notification.application.NotificationTemplate*</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <mutationThreshold>85</mutationThreshold>
                            <coverageThreshold>90</coverageThreshold>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pit-notification-read</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Issue #157: the idempotent read/unread transitions, tenant
                                 authorization and the two retention windows are the critical
                                 mutation-tested notification inbox paths. -->
                            <targetClasses>
                                <param>com.awap.notification.application.NotificationReadService</param>
                                <param>com.awap.notification.application.NotificationDeliveryPurgeScheduler</param>
                                <param>com.awap.notification.domain.NotificationDelivery</param>
                                <param>com.awap.notification.domain.NotificationRetentionPolicy</param>
                                <param>com.awap.notification.infrastructure.JpaNotificationReadStore</param>
                                <param>com.awap.notification.interfaces.api.NotificationController</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.awap.notification.application.*</param>
                                <param>com.awap.notification.domain.*</param>
                                <param>com.awap.notification.infrastructure.JpaNotificationReadStoreTest</param>
                                <param>com.awap.notification.interfaces.api.NotificationControllerWebMvcTest</param>
                            </targetTests>
                            <!-- NotificationDelivery also owns the delivery/retry state machine, which
                                 is mutation-tested by the dedicated retry profile. Only the read-state
                                 members are in scope here, so unrelated getters and transitions are
                                 excluded instead of silently lowering this gate. -->
                            <excludedMethods>
                                <param>dedupeWindowRemaining</param>
                                <param>isDedupeActiveAt</param>
                                <param>scheduleFirstAttempt</param>
                                <param>recordAttempt</param>
                                <param>markSent</param>
                                <param>markRetrying</param>
                                <param>markFailedPermanently</param>
                                <param>markFailed</param>
                                <param>isSent</param>
                                <param>isTerminal</param>
                                <param>getAttempts</param>
                                <param>getBusinessKey</param>
                                <param>getDedupeExpiresAt</param>
                                <param>getDedupeKey</param>
                                <param>getLastAttemptAt</param>
                                <param>getLastError</param>
                                <param>getLeaseToken</param>
                                <param>getLeaseUntil</param>
                                <param>getLocale</param>
                                <param>getNextAttemptAt</param>
                                <param>getRecipient</param>
                                <param>getTemplateKey</param>
                                <param>getVariablesJson</param>
                                <param>getVersion</param>
                            </excludedMethods>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <!-- Keep this report separate: every PIT profile otherwise reuses
                                 target/pit-reports and the last run hides the others in CI. -->
                            <reportsDirectory>${project.build.directory}/pit-reports-notification-read</reportsDirectory>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <mutationThreshold>85</mutationThreshold>
                            <coverageThreshold>90</coverageThreshold>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pit-saga</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Issue #133: reverse ordering, state guards and idempotent
                                 compensation are the critical mutation-tested saga paths. The
                                 conditional/increment mutators are scoped to that behaviour. -->
                            <targetClasses>
                                <param>com.awap.engine.application.SagaService</param>
                                <param>com.awap.engine.domain.SagaInstance</param>
                                <param>com.awap.engine.domain.SagaStep</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.awap.engine.application.SagaServiceTest</param>
                                <param>com.awap.engine.domain.SagaDomainTest</param>
                            </targetTests>
                            <mutators>
                                <mutator>CONDITIONALS_BOUNDARY</mutator>
                                <mutator>REMOVE_CONDITIONALS_EQUAL_IF</mutator>
                                <mutator>REMOVE_CONDITIONALS_EQUAL_ELSE</mutator>
                                <mutator>REMOVE_CONDITIONALS_ORDER_IF</mutator>
                                <mutator>REMOVE_CONDITIONALS_ORDER_ELSE</mutator>
                                <mutator>NEGATE_CONDITIONALS</mutator>
                                <mutator>MATH</mutator>
                                <mutator>INCREMENTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <mutationThreshold>85</mutationThreshold>
                            <coverageThreshold>80</coverageThreshold>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
